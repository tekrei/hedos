<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive'>
<Scene>
<Background groundAngle='1.309, 1.571' groundColor='0.1 0.1 0, 0.4 0.25 0.2, 0.6 0.6 0.6' skyAngle='1.309, 1.571' skyColor='0 0.2 0.7, 0 0.5 1, 1 1 1'/>
<ExternProtoDeclare name='HelixProto' url=' "helicopter.x3d" "x3d/helicopter.x3d" "https://raw.githubusercontent.com/tekrei/hedos/master/src/main/resources/x3d/helicopter.x3d" '/>
<Transform DEF='HelixTransform' scale='0.5 0.5 0.5'>
	<DirectionalLight direction='0 0 1'/>
	<ProtoInstance name='HelixProto' containerField='children'/>
    <!-- The Viewpoint is now a child of the helicopter transform so it follows automatically -->
    <Viewpoint DEF='FollowCamera'
        description="Helicopter View"
        jump='true'
        fieldOfView='0.785'
        position='0 40 120'
        orientation='1 0 0 -0.2'
    />
</Transform>

<TimeSensor DEF='TourTimer'
 cycleInterval='10.000'
 loop='false'
 startTime='.000'
/>

<PositionInterpolator DEF='TourPath'
 key='0 .5 1'
 keyValue='0 0 0 50 0 0 0 0 0'
/>
<ROUTE fromNode='TourTimer' fromField='fraction_changed' 
	   toNode='TourPath' toField='set_fraction'/>
<ROUTE fromNode='TourPath' fromField='value_changed' 
	   toNode='HelixTransform' toField='set_translation'/>
<ROUTE fromNode='TourTimer' fromField='isActive' toNode='FollowCamera' toField='set_bind'/>
</Scene>
</X3D>